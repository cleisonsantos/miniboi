{
  "name": "miniboi",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy:commands": "bun run src/scripts/deploy-commands.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun --external ffmpeg-static",
    "check": "bun run typecheck && bun test && bun run build",
    "ci": "bun audit && bun run check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1",
    "youtube-dl-exec": "^3.1.9",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": "6.27.0",
    "ws": "8.21.1"
  },
  "trustedDependencies": [
    "youtube-dl-exec"
  ]
}
